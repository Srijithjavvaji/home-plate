# ==============================================================
# HOME PLATE - Environment Variables Configuration
# ==============================================================

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Configuration (Test Mode initially)
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_homeplate
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key

# Public App URL for redirects and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
