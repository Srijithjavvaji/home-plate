# ==============================================================
# HOME PLATE - Environment Variables Configuration
# “Fresh Homemade Food, Delivered to Your Doorstep”
# ==============================================================

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Configuration (Test Mode initially)
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_homeplate
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key

# ==============================================================
# Shadowfax Hyperlocal Logistics Partner Configuration
# ==============================================================
# Base URL:
# Staging Sandbox: https://staging-starship.shadowfax.in
# Live Production: https://starship.shadowfax.in
SHADOWFAX_BASE_URL=https://staging-starship.shadowfax.in
SHADOWFAX_API_KEY=your_shadowfax_api_token_here
SHADOWFAX_CLIENT_CODE=your_shadowfax_client_code
SHADOWFAX_WEBHOOK_SECRET=your_shadowfax_webhook_hmac_secret
DEFAULT_DELIVERY_PROVIDER=shadowfax

# Public App URL for redirects, webhooks, and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
